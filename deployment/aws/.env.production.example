# Copy to /opt/collab-editor/.env.production and fill in real values. This file is read by:
#   - docker-compose.production.yml (env_file, passed straight into the server container)
#   - scripts/backup-db.sh (sourced directly for pg_dump credentials)
# Never commit the filled-in .env.production — it's excluded in .gitignore.

# ─── Database (RDS) ─────────────────────────────────────
# POSTGRES_USER/PASSWORD/DB aren't read by the server itself (only DATABASE_URL is — see
# server/src/config/env.ts) but scripts/backup-db.sh needs them for pg_dump.
POSTGRES_USER=collab_admin
POSTGRES_PASSWORD=YOUR_RDS_PASSWORD_HERE
POSTGRES_DB=collab_editor
# sslmode=require encrypts the EC2 <-> RDS connection — RDS accepts unencrypted connections too,
# but there's no reason not to encrypt traffic that's leaving the instance.
DATABASE_URL=postgresql://collab_admin:YOUR_RDS_PASSWORD_HERE@YOUR_RDS_ENDPOINT:5432/collab_editor?schema=public&sslmode=require

# ─── Redis (ElastiCache) ────────────────────────────────
REDIS_HOST=YOUR_ELASTICACHE_ENDPOINT
REDIS_PORT=6379
# ElastiCache's free tier has no AUTH token by default — it's protected by the security group
# (collab-redis-sg only allows traffic from collab-ec2-sg) instead. Leave blank unless you've
# explicitly enabled Redis AUTH on the cluster.
REDIS_PASSWORD=

# ─── Server ─────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Generate with: openssl rand -hex 32 — use two DIFFERENT values, not the same one twice.
JWT_ACCESS_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_ONE_WITH_OPENSSL_RAND_HEX_32
# This is the CORS allow-list origin (server/src/app.ts), so it must match exactly how the site
# is actually reached — scheme included. Use http:// until you've run setup-ssl.sh; switch to
# https:// only once a certificate is in place, or every browser request will fail CORS.
CLIENT_URL=http://YOUR_DOMAIN_OR_IP
# Comma-separated emails allowed into /admin (see server/src/routes/admin.ts). Leaving this
# empty grants admin to whichever account signed up first — fine for a quick demo, but set it
# explicitly before sharing the URL with anyone else.
ADMIN_EMAILS=

# ─── Load testing ───────────────────────────────────────
# Set to "true" only while running the k6 scripts in loadtest/, then set it back and restart.
# It disables HTTP rate limiting and the per-IP WebSocket connection guards, which otherwise
# reject a single-IP load generator within seconds. See loadtest/README.md.
LOAD_TEST_MODE=false

# ─── Client ─────────────────────────────────────────────
CLIENT_PORT=8080
# No VITE_API_URL/VITE_WS_URL here on purpose: the client only ever makes relative fetch()/
# WebSocket calls resolved against window.location (see client/src/api/axios.ts and
# client/src/lib/WebSocketProvider.ts) — there's no separate API origin to configure. The
# host-level Nginx (nginx/collab-editor.conf) and the client container's own Nginx
# (client/nginx/default.conf) both route /api and /ws same-origin, which is what that code path
# is built for.
