# Local (non-Docker) development. Copy to server/.env — server/src/config/env.ts reads these
# via dotenv. For the containerized stack, see .env.docker + docker-compose.yml instead; the
# client needs no env vars at all (see the note near the bottom).

# ─── Database ───────────────────────────────────
# Matches docker-compose.dev.yml's postgres service exactly, so `make dev-infra` (or
# `npm run docker:dev`) works with zero further changes here.
DATABASE_URL=postgresql://collab_user:collab_pass@localhost:5432/collab_editor
POSTGRES_USER=collab_user
POSTGRES_PASSWORD=collab_pass
POSTGRES_DB=collab_editor
POSTGRES_PORT=5432

# Used by server/src/test/setup.ts when set; otherwise it derives a `collab_test` database on
# the same Postgres server as DATABASE_URL above (auto-created by
# scripts/postgres-init/init-test-db.sql the first time the dev postgres volume initializes).
# Point this at docker-compose.dev.yml's `postgres-test` service instead for a fully isolated,
# tmpfs-backed test database.
TEST_DATABASE_URL=postgresql://collab_user:collab_pass@localhost:5432/collab_test

# ─── Redis ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Server ─────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
CLIENT_URL=http://localhost:5173
# Comma-separated list of emails allowed into /admin. Leave empty in development to let the
# first registered user in; set explicitly in production.
ADMIN_EMAILS=

# ─── Client ─────────────────────────────────────
# No VITE_* API/WS URL variables — the client only ever makes relative fetch()/WebSocket calls
# resolved against window.location (see client/src/api/axios.ts and
# client/src/lib/WebSocketProvider.ts). Vite's own dev-server proxy (client/vite.config.ts)
# forwards those to localhost:3001 in development; Nginx's proxy (client/nginx/default.conf)
# does the same same-origin trick in the Docker build.

# ─── Docker Production ──────────────────────────
# (used by docker-compose.yml when run with `--env-file .env.docker` — see that file instead
# of editing these; kept here only so `docker compose config` has a sane fallback.)
CLIENT_PORT=80
