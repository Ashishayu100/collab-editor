generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev (Windows/macOS/glibc Linux) working; the musl target is what
  // actually runs inside the node:20-alpine Docker image (see server/Dockerfile).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String   // bcrypt hashed
  avatarColor   String   @default("#3B82F6") // random color assigned at signup for cursor/presence
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations (will be used later)
  ownedDocuments    Document[]       @relation("DocumentOwner")
  collaborations    Collaborator[]
  comments          Comment[]
  resolvedComments  Comment[]        @relation("ResolvedComments")
  createdVersions   DocumentVersion[]
  folders           Folder[]
  starredDocuments  StarredDocument[]

  @@map("users")
}

model Document {
  id            String   @id @default(cuid())
  title         String   @default("Untitled Document")
  content       Bytes?   // Yjs document state as binary (will be used from Day 6)
  ownerId       String
  isPublic      Boolean  @default(false)
  shareToken    String?  @unique // random token for the invite link; null when link sharing is off
  shareLinkRole Role     @default(VIEWER) // role granted to whoever accepts the invite link
  shareEnabled  Boolean  @default(false)
  folderId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  owner         User            @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folder        Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  collaborators Collaborator[]
  versions      DocumentVersion[]
  comments      Comment[]
  starredBy     StarredDocument[]

  @@index([folderId])
  @@index([ownerId, updatedAt]) // Dashboard "owned" list, sorted by most recently edited
  @@index([title]) // Title search (listDocuments' `search` filter, and GET /documents/search)
  @@map("documents")
}

model Collaborator {
  id            String   @id @default(cuid())
  documentId    String
  userId        String
  role          Role     @default(EDITOR)
  addedAt       DateTime @default(now())

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // @@unique([documentId, userId]) below already indexes documentId-prefixed lookups; this one is
  // for the reverse direction — "shared with me" (documentService.listDocuments' `filter: 'shared'`).
  @@index([userId])
  @@unique([documentId, userId])
  @@map("collaborators")
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNum    Int      // sequential per document, starting at 1
  content       Bytes    // Yjs state snapshot (garbage-collected/compacted)
  sizeBytes     Int      // content.length, cached so version list/heuristics avoid fetching the blob
  title         String   // document title at the time of the snapshot
  label         String?  // optional user-provided name for this snapshot; null marks it as an auto-snapshot
  createdById   String
  createdAt     DateTime @default(now())

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@unique([documentId, versionNum])
  @@map("document_versions")
}

model Comment {
  id            String    @id @default(cuid())
  documentId    String
  userId        String
  content       String

  // Thread structure: top-level comments have no parentId; replies point to the thread root.
  parentId      String?
  parent        Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentThread")

  // Whether this thread is resolved (only meaningful on root comments).
  resolved      Boolean   @default(false)
  resolvedAt    DateTime?
  resolvedById  String?
  resolvedBy    User?     @relation("ResolvedComments", fields: [resolvedById], references: [id])

  // Position anchoring — a text snippet + character offset used to relocate the highlight
  // when re-scanning the document; drift is expected and handled as best-effort on the client.
  anchorText    String?
  anchorOffset  Int?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt]) // Thread list ordered by time (supersedes the plain documentId index)
  @@index([parentId])
  @@map("comments")
}

model Folder {
  id        String     @id @default(cuid())
  name      String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, userId, parentId])
  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

model StarredDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
  @@map("starred_documents")
}

enum Role {
  VIEWER
  EDITOR
  OWNER
}
